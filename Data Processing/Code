----- To view everything inside the dataset
Select *
From `e-commerce`.sales.data;



----------------------------------------------------------------------------------Exploratory Data Analysis----------------------------------------------------------------------------------------------------------

--------1. InvoiceNo----------------------------------------------------------

---To check if there are any null values in the InvoiceNo
Select InvoiceNo
From `e-commerce`.sales.data
WHERE InvoiceNo IS NULL;

---to check the how many invoices are there in the dataset
Select count(DISTINCT InvoiceNo) AS total_invoices
From `e-commerce`.sales.data;

---To see the list of different invoices in the dataset
Select DISTINCT InvoiceNo
From `e-commerce`.sales.data
WHERE InvoiceNo  NOT LIKE 'C%' AND InvoiceNo NOT LIKE '5%' AND InvoiceNo NOT LIKE 'A%';

---To check the number of invoices per customer
Select count(DISTINCT InvoiceNo) AS total_invoices,
customerid
From `e-commerce`.sales.data
Group by customerid;

---Maximum number of customer transaxtions
Select Max(InvoiceNo) AS maxium_transactions
From `e-commerce`.sales.data
WHERE InvoiceNo NOT LIKE 'C%';


--------2. StockCode------------------------------------------------------------------

---To check if there are any null values in the StockCode
Select StockCode
From `e-commerce`.sales.data
WHERE StockCode IS NULL;

---To check the number of unique product codes in the dataset
Select count(DISTINCT StockCode) AS Total_stockcodes
From `e-commerce`.sales.data;

---To see the list  of unique product codes in the dataset
Select DISTINCT StockCode AS diff_codes
From `e-commerce`.sales.data;


--------3. Description----------------------------------------------------------------------

---To check if there are any null values in the Description
Select Description
From `e-commerce`.sales.data
WHERE Description IS NULL;

---To check the number of unique products in the dataset
Select count(DISTINCT Description) AS Total_products
From `e-commerce`.sales.data;

