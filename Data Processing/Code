----CODE

SELECT  StockCode,
CustomerID,
 InvoiceNo,
   CASE
        WHEN InvoiceNo LIKE 'C%' THEN 'Cancelled Orders'
        WHEN InvoiceNo LIKE 'A%' THEN 'Special Orders'
        WHEN InvoiceNo LIKE '5%' THEN 'Standard Orders'
        ELSE 'Other'
    END AS Invoice_Group,
    count(InvoiceNo) AS Total_transactions,
    CASE 
        WHEN COUNT(InvoiceNo) OVER (PARTITION BY CustomerID) = 1 THEN 'One-Time Customers'
        WHEN COUNT(InvoiceNo) OVER (PARTITION BY CustomerID) BETWEEN 2 AND 10 THEN 'Rare Customers'
        WHEN COUNT(InvoiceNo) OVER (PARTITION BY CustomerID) BETWEEN 11 AND 50 THEN 'Occasional Customers'
        WHEN COUNT(InvoiceNo) OVER (PARTITION BY CustomerID) BETWEEN 51 AND 200 THEN 'Regular Customers'
        WHEN COUNT(InvoiceNo) OVER (PARTITION BY CustomerID) BETWEEN 201 AND 1000 THEN 'Frequent Customers'
        ELSE 'Top Customers'
    END AS Customer_Purchasing_Frequency,
   
     Description,
    CASE 
        WHEN Description LIKE '%LANTERN%' 
          OR Description LIKE '%T-LIGHT%'
          OR Description LIKE '%CANDLE%'
          OR Description LIKE '%HOLDER%'
          OR Description LIKE '%DECORATION%'
          OR Description LIKE '%FRAME%'
        THEN 'Home Decor'

        WHEN Description LIKE '%MUG%'
          OR Description LIKE '%TEA%'
          OR Description LIKE '%BOWL%'
          OR Description LIKE '%PLATE%'
          OR Description LIKE '%JUG%'
          OR Description LIKE '%LUNCH BOX%'
          OR Description LIKE '%CUTLERY%'
        THEN 'Kitchen & Dining'

        WHEN Description LIKE '%BAG%'
          OR Description LIKE '%SHOPPER%'
          OR Description LIKE '%STORAGE%'
          OR Description LIKE '%BOX%'
        THEN 'Bags & Storage'

        WHEN Description LIKE '%TOY%'
          OR Description LIKE '%DOLL%'
          OR Description LIKE '%JIGSAW%'
          OR Description LIKE '%GAME%'
          OR Description LIKE '%TEDDY%'
        THEN 'Toys & Kids'

        WHEN Description LIKE '%CARD%'
          OR Description LIKE '%NOTEBOOK%'
          OR Description LIKE '%PENCIL%'
          OR Description LIKE '%WRAP%'
          OR Description LIKE '%STICKER%'
        THEN 'Stationery'

        WHEN Description LIKE '%BAG%'
          OR Description LIKE '%PURSE%'
          OR Description LIKE '%UMBRELLA%'
          OR Description LIKE '%SCARF%'
        THEN 'Accessories'

        WHEN Description LIKE '%CHRISTMAS%'
          OR Description LIKE '%SANTA%'
          OR Description LIKE '%REINDEER%'
        THEN 'Seasonal Activities'

        ELSE 'Other'
    END AS Product_Category,
    Sum(UnitPrice*Quantity) AS Total_Revenue,

    UnitPrice,    
    Quantity,
    Count(Quantity) As Total_Quanties,
    CASE 
            WHEN count(Quantity) OVER(PARTITION BY CustomerID) < 0 THEN 'Returns'
            WHEN count(Quantity) OVER(PARTITION BY CustomerID) = 0 THEN 'No Purchase'
            WHEN count(Quantity) OVER(PARTITION BY CustomerID)BETWEEN 1 AND 100 THEN 'Low Buyers'
            WHEN count(Quantity) OVER(PARTITION BY CustomerID) BETWEEN 101 AND 1000 THEN 'Moderate Buyers'
            WHEN count(Quantity) OVER(PARTITION BY CustomerID) BETWEEN 1001 AND 10000 THEN 'High Buyers'
            WHEN count(Quantity) OVER(PARTITION BY CustomerID) BETWEEN 10001 AND 50000 THEN 'Very High Buyers'
            ELSE 'Bulk Buyers'
            END AS Customer_spending_segment,
    Country,
        CASE 
        WHEN country = 'United Kingdom' THEN 'UK'
        WHEN country IN (
            'France','Germany','Netherlands','Norway','Switzerland','Spain',
            'Poland','Portugal','Italy','Belgium','Lithuania','Iceland',
            'Denmark','Cyprus','Sweden','Austria','Finland','Greece',
            'Czech Republic','Malta','European Community','Channel Islands'
        ) THEN 'Europe'
        WHEN country IN (
            'Israel','Bahrain','United Arab Emirates','Saudi Arabia','Lebanon'
        ) THEN 'Middle East'
        WHEN country IN (
            'Japan','Hong Kong','Singapore'
        ) THEN 'Asia'
        WHEN country IN (
            'USA','Canada'
        ) THEN 'North America'
        WHEN country IN (
            'Australia'
        ) THEN 'Oceania'
        WHEN country IN (
            'RSA'
        ) THEN 'Africa'
        WHEN country IN (
            'Brazil'
        ) THEN 'South America'
        WHEN country = 'Unspecified' THEN 'Unspecified'
        ELSE 'Other'
       END AS region,
count(Distinct CustomerID) AS Total_customer,
     date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'yyyy-MM-dd HH:mm:ss'
    ) AS New_invoice_date,
year(date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'yyyy-MM-dd HH:mm:ss'
    )) AS year,
date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'MMMM'
    ) AS monthname,
date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'EEEE'
    ) AS day_name,
date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'H'
    ) AS hour,
    
    CASE
        WHEN date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'EEEE'
    ) IN ('Saturday','Sunday') THEN 'Weekend'
        ELSE 'Weekday'
    END AS Weekday_Classification

    From `e-commerce`.sales.data
    WHERE CustomerID IS NOT NULL AND InvoiceDate IS NOT NULL AND Description IS NOT NULL AND   date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'yyyy-MM-dd HH:mm:ss'
    ) IS NOT NULL
    Group by StockCode,InvoiceNo,invoice_group,CustomerID, Country, region, New_invoice_date, year, monthname, day_name, hour, Weekday_Classification,Quantity,UnitPrice,Description
    ;
  
