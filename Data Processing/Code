--------5. InvoiceDate--------------------------------------------------------

---To check if there are any null values in the InvoiceDate
Select InvoiceDate
From `e-commerce`.sales.data
WHERE InvoiceDate IS null;

---To check the different dates and to spot invalid values
Select distinct(InvoiceDate) AS diff_dates
From `e-commerce`.sales.data;

---To change the time format to a proper standard
SELECT InvoiceDate,
    date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'yyyy-MM-dd HH:mm:ss'
    ) AS formatted_invoice_date
FROM `e-commerce`.sales.data;

---Extracting year
Select year(date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'yyyy-MM-dd HH:mm:ss'
    )) AS year
From `e-commerce`.sales.data;

---Extracting Monthname
SELECT 
    date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'MMMM'
    ) AS monthname
FROM `e-commerce`.sales.data;

---Extracting DayName
SELECT 
    date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'EEEE'
    ) AS day_name
FROM `e-commerce`.sales.data;

---Extracting Hour
SELECT 
    date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'H'
    ) AS hour
FROM `e-commerce`.sales.data;


---Creating weekday classification and quarters
select date_format(TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'), 'MMMM') AS monthname,
CASE 
        WHEN date_format(TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'), 'MMMM') IN ('January','February','March') THEN 'Q1'
        WHEN date_format(TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'), 'MMMM') IN ('April','May','June') THEN 'Q2'
        WHEN date_format(TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'), 'MMMM') IN ('July','August','September') THEN 'Q3'
        ELSE 'Q4'
    END AS quarter,
    CASE
        WHEN date_format(
        TRY_TO_TIMESTAMP(InvoiceDate, 'd/M/yyyy H:mm'),
        'EEEE'
    ) IN ('Saturday','Sunday') THEN 'Weekend'
        ELSE 'Weekday'
    END AS Weekday_Classification
from `e-commerce`.sales.data;



