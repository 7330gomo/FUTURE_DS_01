Select distinct(Description) AS Different_products
From `e-commerce`.sales.data;


--------4. Quantity--------------------------------------------------------

---To check if there are any null values in the Quantity
Select Quantity
From `e-commerce`.sales.data
WHERE Quantity IS NULL;

---To check the total quantity in the dataset
Select sum(quantity) AS total_Qty
From `e-commerce`.sales.data;

